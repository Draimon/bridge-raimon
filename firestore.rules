rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connexion obligatoire (15/11/2026) : parties, remarques et vocaux réservés aux comptes de la famille.
    function famille() {
      return request.auth != null && request.auth.token.email in [
        'michele@systeme-raimon.app', 'damien@systeme-raimon.app', 'helene@systeme-raimon.app'
      ];
    }

    // Parties et remarques : un seul champ « data » (texte), jamais d'effacement
    function texteSeul() {
      return request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    match /parties/{partie} {
      allow read: if famille();
      allow create, update: if famille() && texteSeul();
      allow delete: if false;
    }

    match /corrections/{correction} {
      allow read: if famille();
      allow create, update: if famille() && texteSeul();
      allow delete: if false;
    }

    // Vocaux : création au bon format, seul « écouté » modifiable, effacement après 30 jours seulement
    match /vocaux/{vocal} {
      allow read: if famille();
      allow create: if famille() && ((
          request.resource.data.keys().hasOnly(['partie', 'donne', 'auteur', 'pour', 'date', 'duree', 'ecoute', 'parts', 'mime', 'audio'])
          && request.resource.data.audio is string
          && request.resource.data.date is int
        ) || (
          request.resource.data.keys().hasOnly(['chunkOf', 'date', 'audio'])
          && request.resource.data.audio is string
        ));
      allow update: if famille()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ecoute'])
        && request.resource.data.ecoute is bool;
      allow delete: if famille()
        && resource.data.date is int
        && resource.data.date < request.time.toMillis() - 2592000000;
    }

    // ───── Salon de bridge (15/11/2026) : ouvert à tous les joueurs connectés, invités compris
    function connecte() { return request.auth != null; }
    function maintenant() { return request.time.toMillis(); }

    // Présence : chacun écrit la sienne ; les vieilles (plus d'un jour) peuvent être effacées par tous
    match /presence/{uid} {
      allow read: if connecte();
      allow create, update: if connecte() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom', 'invite', 'ou', 't'])
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 40;
      allow delete: if connecte() && (request.auth.uid == uid || resource.data.t < maintenant() - 86400000);
    }
    // Chat général : message à son nom, 400 caractères max ; effaçable une fois sa semaine terminée
    match /chat/{msg} {
      allow read: if connecte();
      allow create: if connecte() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nom', 'texte', 't', 'sem'])
        && request.resource.data.texte is string && request.resource.data.texte.size() <= 400
        && request.resource.data.sem is int && request.resource.data.sem <= maintenant()
        && request.resource.data.sem > maintenant() - 691200000;
      allow delete: if connecte() && resource.data.sem < maintenant() - 518400000;
    }
    // Tables : tout l'état d'une table dans un document ; effaçable après 2 jours sans activité
    match /tables/{table} {
      allow read, create, update: if connecte();
      allow delete: if connecte() && resource.data.maj < maintenant() - 172800000;
    }
    // Donnes déjà jouées : chacun tient sa liste
    match /joues/{uid} {
      allow read: if connecte();
      allow write: if connecte() && request.auth.uid == uid;
    }
    // Résultats : ajout seulement
    match /resultats/{res} {
      allow read, create: if connecte();
    }
  }
}
